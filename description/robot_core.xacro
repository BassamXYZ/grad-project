<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!--  ROBOT PROPERTIES                                            -->
  <!-- ============================================================ -->
  <xacro:property name="chassis_length"  value="0.27" />
  <xacro:property name="chassis_width"   value="0.18" />
  <xacro:property name="chassis_height"  value="0.127" />
  <xacro:property name="chassis_mass"    value="1.5" />

  <xacro:property name="wheel_radius"    value="0.033" />
  <xacro:property name="wheel_thickness" value="0.03" />
  <xacro:property name="wheel_mass"      value="0.05" />
  <!-- Wheel positions relative to chassis frame (at chassis centre) -->
  <xacro:property name="wheel_x" value="0.0" />
  <xacro:property name="wheel_y" value="0.09" />
  <xacro:property name="wheel_z" value="-0.0705" />

  <xacro:property name="support_radius"  value="0.014" />
  <xacro:property name="support_mass"    value="0.05" />
  <xacro:property name="support_x"       value="0.121" />
  <xacro:property name="support_y"       value="0.076" />
  <xacro:property name="support_z"       value="-0.0895" />

  <xacro:property name="imu_mass"  value="0.01" />
  <xacro:property name="imu_size"  value="0.02" />

  <!-- The robot's base link is placed at the ground contact point -->
  <xacro:property name="base_z_offset" value="0.0" />

  <!-- ============================================================ -->
  <!--  MATERIALS                                                   -->
  <!-- ============================================================ -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1" />
  </material>
  <material name="orange">
    <color rgba="1 0.3 0.1 1"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.2 1 1"/>
  </material>
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
    
  <!-- ============================================================ -->
  <!--  BASE LINKS AND ROOT                                         -->
  <!-- ============================================================ -->
  <!-- The base_footprint is the virtual ground contact point -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0" />
  </joint>

  <!-- The base_link is the main frame, located at the chassis centre height? -->
  <!-- We'll place base_link at the chassis centre to simplify transforms. -->
  <!-- But original had base_link at (0,0,0) and chassis joint offset. We'll keep that -->
  <!-- for compatibility: base_link is at (0,0,0) and chassis is offset. -->
  <!-- However, we now have base_footprint at ground, and base_link at z=0. So chassis -->
  <!-- centre is at z=0.115, as before. -->
  <link name="base_link" />

  <!-- ============================================================ -->
  <!--  CHASSIS                                                     -->
  <!-- ============================================================ -->
  <joint name="base_link_chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis" />
    <origin xyz="0 0 ${chassis_height/2 + 0.04}" rpy="0 0 0" />
  </joint>

  <link name="chassis">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="grey" />
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}"
                        x="${chassis_length}"
                        y="${chassis_width}"
                        z="${chassis_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/> 
    </xacro:inertial_box>
  </link>

  <gazebo reference="chassis">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- ============================================================ -->
  <!--  MACRO: CREATE A DRIVE WHEEL                                 -->
  <!-- ============================================================ -->
  <xacro:macro name="drive_wheel" params="name side x y z">
    <!-- side: 'left' or 'right' to set joint axis sign? Actually we use same axis, -->
    <!-- but we can set different orientation? No, we keep same. -->
    <link name="${name}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}"
                               length="${wheel_thickness}"
                               radius="${wheel_radius}" >
        <origin xyz="0 0 0" rpy="0 0 0"/> 
      </xacro:inertial_cylinder>
    </link>

    <joint name="${name}_wheel_joint" type="fixed">
      <parent link="chassis" />
      <child link="${name}_wheel" />
      <!-- The wheel is rotated so its axis aligns with Y (roll direction) -->
      <origin xyz="${x} ${y} ${z}" rpy="${pi/2} 0 0" />
      <axis xyz="0 0 1" />
      <dynamics damping="0.0" friction="0.0" />
    </joint>

    <gazebo reference="${name}_wheel">
      <material>Gazebo/Blue</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <friction>1.0</friction>
    </gazebo>
  </xacro:macro>

  <!-- Instantiate the two drive wheels -->
  <xacro:drive_wheel name="left"  side="left"  x="${wheel_x}" y="-${wheel_y}" z="${wheel_z}" />
  <xacro:drive_wheel name="right" side="right" x="${wheel_x}" y="${wheel_y}"  z="${wheel_z}" />

  <!-- ============================================================ -->
  <!--  MACRO: CREATE A SUPPORT CASTER (sphere)                     -->
  <!-- ============================================================ -->
  <xacro:macro name="support_caster" params="name x y z">
    <link name="support_${name}">
      <visual name="support_caster">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${support_radius}" />
        </geometry>
        <material name="black" />
      </visual>
      <visual name="support_caster_stand">
        <origin xyz="0 0 0.02" rpy="0 0 ${-pi/2}"/>
        <geometry>
          <cylinder radius="0.01" length="0.014"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${support_radius}" />
        </geometry>
      </collision>
      <xacro:inertial_sphere mass="${support_mass}"
                             radius="${support_radius}" >
        <origin xyz="0 0 0" rpy="0 0 0"/> 
      </xacro:inertial_sphere>
    </link>

    <joint name="support_${name}_joint" type="fixed">
      <parent link="chassis" />
      <child link="support_${name}" />
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
    </joint>

    <gazebo reference="support_${name}">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <friction>0.01</friction>
    </gazebo>
  </xacro:macro>

  <!-- Four corners -->
  <xacro:support_caster name="front_left"  x="${support_x}"  y="${support_y}"  z="${support_z}" />
  <xacro:support_caster name="front_right" x="${support_x}"  y="-${support_y}" z="${support_z}" />
  <xacro:support_caster name="back_left"   x="-${support_x}" y="${support_y}"  z="${support_z}" />
  <xacro:support_caster name="back_right"  x="-${support_x}" y="-${support_y}" z="${support_z}" />

  <!-- ============================================================ -->
  <!--  IMU SENSOR                                                  -->
  <!-- ============================================================ -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size/4}" />
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size/4}" />
      </geometry>
    </collision>
    <xacro:inertial_box mass="${imu_mass}"
                        x="${imu_size}"
                        y="${imu_size}"
                        z="${imu_size/2.5}" >
      <origin xyz="0 0 0" rpy="0 0 0"/> 
    </xacro:inertial_box>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 ${chassis_height + 0.034}" rpy="0 0 0" />
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        <frame_id>imu_link</frame_id>
      </plugin>
    </sensor>
  </gazebo>
</robot>
